# ---------------------------------------------------------------------------
# Unity generated folders
# ---------------------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/

# Asset meta data is derived from the project, regenerated on import
/[Aa]sset[Mm]eta[Dd]ata/

# Autogenerated project files (regenerated by the IDE / Unity)
/*.csproj
/*.unityproj
/*.sln
/*.suo
/*.user
/*.userprefs
/*.pidb
/*.booproj
/*.svd
/*.opendb
/*.VC.db
/*.stackdump

# IDE folders
/.idea/
/.local/
/.settings/
/Temp/
.vs/
.vscode/
.gradle/
*.swp
*~

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# Crash / diagnostic logs
sysinfo.txt
crashlytics-build.properties
*.stackdump

# NuGet / dotnet
*.nupkg
*.snupkg
.nuget/

# ---------------------------------------------------------------------------
# IMPORTANT: the folders above are NOT tracked, but everything else is.
# In a group project you MUST commit all of the following so your teammates
# get a working project:
#
#   Assets/            (including every .cs, .unity, .prefab, .mat, .asset,
#                       .anim, .controller, .blend, and ALL .meta files)
#   Packages/          (manifest.json + packages-lock.json)
#   ProjectSettings/   (all .asset files, ProjectVersion.txt, TagManager.asset)
#   .gitignore
#   .gitattributes
#
# .meta files are critical. Unity uses their GUIDs to link assets together, so
# if a teammate is missing one, every reference to that asset breaks.
# Do NOT add blanket rules like *.meta or Assets/ to this file.
#
# .csproj and .sln are ignored on purpose - they are regenerated per machine
# and differ between developers, which causes noisy merge conflicts.
# ---------------------------------------------------------------------------
